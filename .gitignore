# stay tracked — they drive classification, query routing, and ranking weights.

# --- Test artifacts (large, regenerable) ---
data/test_queries/
data/test_classification/
data/test_collections/
data/eval_docling/
data/eval_retrieval/

# --- Demo + reference corpora (large, reproducible from scripts/) ---
data/demo/
data/frontend_V1/
data/*.pdf

# --- Test PDFs at repo root (legacy fixtures, large) ---
test cases/
test cases1/

# --- Local-only working notes (plans, mockups, research, vendor binaries) ---
docs/

# --- Frontend build / dev artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/screenshots/
screenshots/

# --- Local Claude Code settings ---
.claude/settings.local.json

# Backups written beside a source file by patch tooling. One of these was committed to main
# on 2026-09-04: the patch script wrote it next to the file it was editing, inside the repo,
# and `git add app/` swept it up. Ignoring the shape is the fix; remembering not to add it is not.
*.bak-*
*.orig

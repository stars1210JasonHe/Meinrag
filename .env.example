# LLM Provider: "openai" or "openrouter"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (only needed if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=MEINRAG

# Vector Store: "chroma" or "faiss"
VECTOR_STORE=faiss

# Paths
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore
METADATA_FILE=data/metadata.json

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Document parsing: "default" (text only) | "enhanced" (tables+images, PDF only) | "vision" (all file types)
# Legacy: PDF_PARSE_MODE is still accepted for backward compatibility
PARSE_MODE=default
IMAGE_DESCRIPTION_MODEL=gpt-4o-mini
IMAGE_DESCRIPTION_MAX_TOKENS=512

# Vision mode settings
VISION_MODEL=gpt-4o-mini       # Vision-capable model (gpt-4o, gpt-4o-mini)
VISION_MAX_TOKENS=4096          # Max tokens per page response
VISION_PAGE_DPI=150             # Page render quality (100=fast/cheap, 300=high quality)
# Vision mode requires LibreOffice for non-PDF files:
#   Windows: https://www.libreoffice.org/download/download/
#   Linux:   sudo apt install libreoffice
#   macOS:   brew install --cask libreoffice

# Retrieval
RETRIEVAL_TOP_K=4

# Re-ranking (LLM-based, off by default)
RERANK_ENABLED=false
RERANK_TOP_N=4

# Hybrid Search (BM25 + vector fusion, off by default)
HYBRID_SEARCH_ENABLED=false
HYBRID_BM25_WEIGHT=0.5

# Chat Memory
MEMORY_MAX_MESSAGES=20
MEMORY_SESSION_TTL=3600

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# .env.example — copy to .env and fill in OPENAI_API_KEY at minimum.
#
# Quick start (Docker prod stack, see README "Run from scratch"):
#   cp .env.example .env  → set OPENAI_API_KEY  → docker compose -f docker-compose.prod.yml up

# ── Required ─────────────────────────────────────────────────
# OpenAI key for embeddings (text-embedding-3-small) and the chat LLM.
OPENAI_API_KEY=sk-...

# ── LLM provider ─────────────────────────────────────────────
LLM_PROVIDER=openai                       # openai | openrouter
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (only if LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Database ─────────────────────────────────────────────────
# In docker-compose.prod.yml DATABASE_URL is overridden to point at
# the postgres service. For non-Docker dev, leave it pointing at
# localhost (or use SQLite).
# DATABASE_URL=postgresql+asyncpg://meinrag:meinrag@localhost:5432/meinrag
# DATABASE_URL=sqlite+aiosqlite:///./data/meinrag.db   # alt: SQLite

# Used by docker-compose.prod.yml to provision the postgres container.
# Postgres is only reachable on the internal Docker network (no host
# port exposed), so a weak password is contained — but still set one.
POSTGRES_USER=meinrag
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=meinrag

# ── Vector store ─────────────────────────────────────────────
VECTOR_STORE=faiss                        # faiss | chroma

# ── Parser ───────────────────────────────────────────────────
PARSE_MODE=docling                        # docling | unstructured | default
# IMAGE_DESCRIPTION_MODEL=gpt-4o-mini

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval (default-on as of 2026-04-22) ──────────────────
RETRIEVAL_TOP_K=10                        # default-on flip; bumped from 4
ROUTER_ENABLED=true                       # router LLM doc pre-filter, default-on

# ── Re-rank + hybrid search (off by default) ─────────────────
RERANK_ENABLED=false
HYBRID_SEARCH_ENABLED=false
HYBRID_BM25_WEIGHT=0.5

# ── Chunk summary (default-on as of 2026-04-19 M6 fix) ───────
SUMMARY_ENABLED=true

# ── Chat memory ──────────────────────────────────────────────
MEMORY_MAX_MESSAGES=20
MEMORY_SESSION_TTL=2592000                # 30 days (fixed 2026-04-20 — was 1h, caused data loss)

# ── Background tasks ─────────────────────────────────────────
TASK_BACKEND=fastapi                      # fastapi (default) | arq (needs redis)

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
HOST_PORT=5173                            # public port for the frontend (Docker prod stack)

# ── Paths (rarely change) ────────────────────────────────────
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore

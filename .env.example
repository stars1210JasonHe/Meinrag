# .env.example — Copy to .env and edit. Every Settings field from
# app/config.py is listed below, grouped by purpose. Defaults shown match
# the code; commented-out lines = use the default.
#
# Quick start (Docker prod stack):
#   cp .env.example .env  →  set OPENAI_API_KEY  →  docker compose -f docker-compose.prod.yml up
# Quick start (local dev):
#   cp .env.example .env  →  set OPENAI_API_KEY  →  uv run uvicorn app.main:app --reload

# ── Required ─────────────────────────────────────────────────
# OpenAI key drives both the chat LLM and the embedding model
# (text-embedding-3-small). Even when LLM_PROVIDER=openrouter, embeddings
# still go through OpenAI — OpenRouter doesn't reliably support embeddings.
OPENAI_API_KEY=sk-...

# ── LLM provider ─────────────────────────────────────────────
LLM_PROVIDER=openai                       # openai | openrouter
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (only when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_SITE_NAME=MEINRAG

# ── Database ─────────────────────────────────────────────────
# Default is SQLite (zero-setup, local file). Switch to Postgres for
# multi-user / production. In docker-compose.prod.yml DATABASE_URL is
# overridden to point at the in-network postgres service automatically.
# DATABASE_URL=sqlite+aiosqlite:///data/meinrag.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meinrag

# Used by docker-compose.prod.yml to provision the postgres container.
# Postgres is only reachable on the internal Docker network (no host port
# exposed), so a weak password is contained — but still set one.
POSTGRES_USER=meinrag
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=meinrag

# ── Vector store ─────────────────────────────────────────────
VECTOR_STORE=faiss                        # faiss | chroma

# ── Document parsing ─────────────────────────────────────────
# default  — text-only extraction (fast, all file types)
# enhanced — tables + images via PyMuPDF (PDF only, falls back to default)
# vision   — render pages as images → vision LLM → markdown (slow, all types)
# docling  — neural layout analysis (best accuracy, requires `uv sync --extra docling`)
PARSE_MODE=docling
# IMAGE_DESCRIPTION_MODEL=gpt-4o-mini
# IMAGE_DESCRIPTION_MAX_TOKENS=512
# POPPLER_FIGURE_EXTRACTION=true

# Vision mode (only when PARSE_MODE=vision)
# VISION_MODEL=gpt-4o-mini
# VISION_MAX_TOKENS=4096
# VISION_PAGE_DPI=150

# Docling mode (only when PARSE_MODE=docling)
# DOCLING_OCR=false
# DOCLING_PICTURE_DESCRIPTION=false
# DOCLING_EQUATION_OCR=false                # pix2tex LaTeX OCR — heavy
# DOCLING_DEVICE=auto                       # auto | cpu | cuda | mps

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=10                        # bumped from 4 in the 2026-04-22 default-on flip
# QUERY_EXPANSION_ENABLED=true             # re-query with LLM-expanded terms when scores are low
# QUERY_EXPANSION_SCORE_THRESHOLD=0.3
# OPEN_QUESTION_DETECTION=false            # section-aware sampling for very broad queries
# DEDUP_THRESHOLD=0.7                      # hybrid Jaccard similarity for dedup
# QUERY_TYPES_FILE=data/query_types.json
# SCORING_PROFILE=general
# SCORING_RECENCY_DECAY=0.001              # currently unused — placeholder for future recency signal

# ── Hybrid search (default-on as of 2026-04-21) ──────────────
# Dense vectors + BM25 keyword merged via Reciprocal Rank Fusion.
# Dense alone misses exact-keyword queries (e.g., "7B", "175 billion").
HYBRID_SEARCH_ENABLED=true
# HYBRID_BM25_WEIGHT=0.5                   # legacy ensemble weight; retrieval.py uses RRF
# RRF_K=60                                 # standard RRF constant from Cormack et al. 2009

# ── Re-rank (off by default) ─────────────────────────────────
RERANK_ENABLED=false
# RERANK_TOP_N=4
# RERANK_PROVIDER=flashrank                # flashrank | cross-encoder | jina | cohere | llm
# RERANK_MODEL=                            # empty = auto-pick default per provider

# ── Router prefix (default-on as of 2026-04-22) ──────────────
# Pre-filter docs via small LLM before vector search when scope is large.
# Cuts downstream rerank/budget cost. Fail-safe (any error returns full scope).
ROUTER_ENABLED=true
# ROUTER_MIN_SCOPE=15                      # below this many docs, router is bypassed
# ROUTER_TOP_K=8                           # how many docs router picks
# ROUTER_MODEL=gpt-4o-mini

# ── Chunk summary (default-on as of 2026-04-19) ──────────────
# Per-chunk LLM summaries form the "compiled retrieval" layer.
SUMMARY_ENABLED=true
# SUMMARY_PROVIDER=openai                  # openai | openrouter
# SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_MIN_CHARS=200                    # below this, chunk is skipped
# SUMMARY_MAX_CHUNKS_FOR_OVERVIEW=30       # stride-sampled across doc

# ── Graph edges ──────────────────────────────────────────────
# Min cosine similarity to keep a cross-doc similar_to edge. Affects both
# visualization AND retrieval scoring (graph_score in composite).
# GRAPH_SIMILAR_MIN_SCORE=0.6

# ── Visual proximity ─────────────────────────────────────────
# Link image/table/formula chunks to their caption via page proximity.
# VISUAL_PROXIMITY_ENABLED=true
# VISUAL_PROXIMITY_PAGES=1                 # search this many pages before/after

# ── Context window management ────────────────────────────────
# Effective input budget = min(MAX_CONTEXT_TOKENS or ∞, model_window × ratio)
#                          − reserved_output − reserved_overhead
# Used by the budget-aware chunk selector to avoid LLM context overruns.
# MAX_CONTEXT_TOKENS=                       # hard cap; empty = derive from model window
# CONTEXT_BUDGET_RATIO=0.6                  # fraction of model window available for input
# RESERVED_OUTPUT_TOKENS=2048               # space for the LLM's generated answer
# RESERVED_PROMPT_OVERHEAD_TOKENS=512       # system prompt + template overhead
# HISTORY_MAX_BUDGET_RATIO=0.4              # chat history ≤ this fraction of input
# HISTORY_MIN_RESERVE_RATIO=0.2             # but always reserve at least this much

# ── Chat memory ──────────────────────────────────────────────
# MEMORY_MAX_MESSAGES=20
MEMORY_SESSION_TTL=2592000                  # 30 days. Pre-2026-04-20 default of 1h
                                            # caused silent data loss; treat as a floor.

# ── Web search fallback ──────────────────────────────────────
# Triggered on empty retrieval results or explicit force_web_search=true.
WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=9
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_SCORE_THRESHOLD=0.0           # 0 disables score-based auto-fallback

# ── User system ──────────────────────────────────────────────
# DEFAULT_USER=admin
# USER_ISOLATION=all                       # all | documents | none

# ── Background tasks ─────────────────────────────────────────
TASK_BACKEND=background                     # background (FastAPI) | arq (needs Redis)
# REDIS_URL=redis://localhost:6379

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
HOST_PORT=5173                              # public port for the Docker prod stack frontend
# CORS_ORIGINS=http://localhost:5173
# MAX_UPLOAD_SIZE_MB=50

# ── Paths (rarely change) ────────────────────────────────────
# UPLOAD_DIR=data/uploads
# VECTORSTORE_DIR=data/vectorstore

# ─── Anonymization (optional) ─────────────────────────────────────────
# Set to true to enable PII de-identification on new uploads.
# Requires: uv sync --extra anonymization + spaCy models (see README).
ANONYMIZATION_ENABLED=false

# Fernet key for encrypting the mapping table at rest. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED when ANONYMIZATION_ENABLED=true. Back this up — losing it
# means anonymized docs cannot be de-anonymized.
# ANONYMIZATION_ENCRYPTION_KEY=

# Languages to load NER models for. CSV. Default: en,zh.
# Each language adds ~500 MB to the venv (one-time spaCy download).
# ANONYMIZATION_LANGUAGES=en,zh

# Min confidence to anonymize a span (0.0 - 1.0). Lower = more entities
# pseudonymized, higher false-positive rate. Default 0.7.
# ANONYMIZATION_CONFIDENCE_THRESHOLD=0.7
